# Copy to .env.local for local dev (never commit .env.local).

# Redis: Vercel Marketplace → Upstash Redis integration.
# Vercel may inject either UPSTASH_* or KV_* names depending on integration setup.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# KV_REST_API_URL=https://your-redis.upstash.io
# KV_REST_API_TOKEN=your-upstash-rest-token

# Optional: cap retained best-effort usage events in Redis.
USAGE_EVENTS_MAX=10000

# Must match what admins type in the Admin tab (set on Vercel for production).
NEWSLETTER_ADMIN_PASSWORD=choose-a-strong-password
